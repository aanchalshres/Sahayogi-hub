        <div className="text-center mb-16">
          <div className="reveal inline-flex items-center gap-2 bg-[#4F46C8]/10 text-[#4F46C8] text-[11.5px] font-bold px-4 py-1.5 rounded-full uppercase tracking-widest mb-4">
