  useEffect(() => { fetchAnalytics(); }, []);

  const fetchAnalytics = async () => {
    try {
      setLoading(true);
      setError("");
      const res = await apiGet<any>("/admin/analytics/dashboard");
      setDashboard(res.data);
    } catch (err: any) {
      setError(err.message || "Failed to load analytics.");
