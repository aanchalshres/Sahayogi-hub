        if ($request->filled('search')) {
            $s = $request->search;
            $query->where(function ($q) use ($s) {
                $q->whereHas('volunteer.user', fn ($uq) => $uq->where('name', 'like', "%{$s}%")
                    ->orWhere('email', 'like', "%{$s}%"))
