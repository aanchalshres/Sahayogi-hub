                      {n.urgency_level}
                    </span>
                    <span>{timeAgo(n.created_at)}</span>
                  </div>
                </div>

                <button
                  onClick={(e) => {
                    e.stopPropagation()
                    deleteNotification(n.id)
                  }}
                  className="text-[#6B7280] hover:text-[#B9455E] transition self-start"
                >
                  <Trash2 className="h-4 w-4" />
                </button>
              </div>
            )
          })}
        </div>
      </div>
    </div>
  )
}
