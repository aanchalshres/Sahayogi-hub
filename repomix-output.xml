                    'start_date'           => $tData['start_date'],
                    'end_date'             => $tData['end_date'],
                    'application_deadline' => $tData['application_deadline'],
                    'status'               => $tData['status'],
                    'urgency_level'        => $tData['urgency_level'],
                    'created_by'           => $ngo->user_id,
                ]
            );

            // Sync skills
            $skillIds = [];
            foreach ($tData['skills'] as $skillName) {
                if (isset($skills[$skillName])) {
                    $skillIds[] = $skills[$skillName];
                }
            }
            $task->skills()->sync($skillIds);
        }

        $this->command?->info('TaskSeeder executed successfully: 20 realistic tasks seeded.');
    }
}
