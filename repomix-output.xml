            $ngo = $ngos->get($tData['ngo']);
            if (!$ngo) continue;

            $categoryId = $categories->get($tData['category']);
            if (!$categoryId) continue;

            $slug = Str::slug($tData['title']);

            $task = Task::updateOrCreate(
                ['slug' => $slug],
                [
                    'ngo_id'               => $ngo->id,
                    'category_id'          => $categoryId,
