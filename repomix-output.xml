                      <button
                        onClick={() => updateStatus(app.id, 'rejected')}
                        className="flex-1 bg-white border border-[#CACDD3] hover:bg-[#B9C0D4]/20 text-[#111827] text-sm font-medium py-2 rounded-lg transition-colors"
                      >
                        Reject
                      </button>
                    </div>
                  )}
                </div>
              );
            })}
          </div>
        )}
      </div>
    </div>
  );
}
